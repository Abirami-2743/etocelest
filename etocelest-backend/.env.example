# Required
GROQ_API_KEY=

# Models (openai/gpt-oss-120b supports strict JSON-schema output; llama-3.3-70b-versatile uses JSON-object mode)
GROQ_MODEL_AGENT=openai/gpt-oss-120b
GROQ_MODEL_JUDGE=openai/gpt-oss-120b
# GROQ_STRUCTURED_MODE=auto        # auto | json_schema | json_object
# GROQ_REASONING_EFFORT=low        # only set for models that support it, otherwise Groq returns 400

# Server
ENVIRONMENT=development
LOG_LEVEL=INFO
# MongoDB: local mongod, Docker, or Atlas (mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=etocelest
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Debate
MIN_ROUNDS=2
MAX_ROUNDS=4
MAX_SHIFT_DAYS=60
MAX_CONCURRENT_DEBATES=2
# GRAPH_STEP_HEADROOM=4            # spare LangGraph steps on top of the worst-case path (derived from MAX_ROUNDS)

# Abuse protection
RATE_LIMIT_MISSIONS_PER_HOUR=20
MAX_ACTIVE_MISSIONS_PER_OWNER=2
